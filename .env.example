# Copie este ficheiro para .env e substitua os valores antes de iniciar.
SECRET_KEY=gere-uma-chave-secreta-unica
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

POSTGRES_DB=folhas_horas
POSTGRES_USER=folhas_horas
POSTGRES_PASSWORD=substitua-por-uma-palavra-passe-forte
DB_NAME=folhas_horas
DB_USER=folhas_horas
DB_PASSWORD=substitua-por-uma-palavra-passe-forte
DB_HOST=db
DB_PORT=5432

# SMTP para convites e recuperação de palavra-passe. Consulte as definições SMTP do fornecedor.
# Gmail/Workspace: smtp.gmail.com, porta 587, TLS; requer palavra-passe de aplicação.
# Microsoft 365: smtp.office365.com, porta 587, TLS; SMTP AUTH tem de estar permitido.
# Não use a palavra-passe normal da caixa de correio em EMAIL_HOST_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Use um endereço de remetente verificado/autorizado pelo fornecedor SMTP.
DEFAULT_FROM_EMAIL=noreply@example.com
